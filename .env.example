# Copy to .env and adjust. .env is git-ignored.
DATABASE_URL=postgresql+asyncpg://booking:booking@localhost:5432/booking_agent
# The test suite reads this from the environment (this value is its default). It drops and
# recreates the public schema, so it refuses any database whose name doesn't end in _test.
TEST_DATABASE_URL=postgresql+asyncpg://booking:booking@localhost:5432/booking_agent_test
