# Copy to .env and adjust. .env is git-ignored.
DATABASE_URL=postgresql+asyncpg://booking:booking@localhost:5432/booking_agent
# The test suite reads this from the environment (this value is its default). It drops and
# recreates the public schema, so it refuses any database whose name doesn't end in _test.
TEST_DATABASE_URL=postgresql+asyncpg://booking:booking@localhost:5432/booking_agent_test
# The eval harness (python -m evals run) wipes and migrates this one at the start of every run.
# It refuses any database whose name doesn't end in _eval.
EVAL_DATABASE_URL=postgresql+asyncpg://booking:booking@localhost:5432/booking_agent_eval

# LLM provider (DESIGN section 8). Any OpenAI-compatible endpoint works; these are the defaults.
DEEPSEEK_API_KEY=
# LLM_BASE_URL=https://api.deepseek.com
# LLM_MODEL=deepseek-flash
# LLM_THINKING=false

# The web-chat simulator lets anyone text the agent as any number. Development only.
# SIMULATOR_ENABLED=true
